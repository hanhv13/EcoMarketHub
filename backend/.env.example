# ============================================================
# FILE: backend/.env
# CHỨC NĂNG: Lưu các biến môi trường bí mật
# QUAN TRỌNG: File này KHÔNG được push lên GitHub!
#             Đã được thêm vào .gitignore rồi
# NGƯỜI PHỤ TRÁCH: M1
# ============================================================

# Cổng server Node.js chạy trên
PORT=5000

# Thông tin kết nối MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=        # <- Điền mật khẩu MySQL của máy bạn vào đây
DB_NAME=ecomarkethub
DB_PORT=3306

# JWT Secret - Chuỗi bí mật để tạo token đăng nhập
# Thay bằng 1 chuỗi ngẫu nhiên dài, ví dụ: openssl rand -base64 32
JWT_SECRET=secondnest_super_secret_key_2024_do_not_share

# Thời gian hết hạn của token (7 ngày)
JWT_EXPIRES_IN=7d

# URL frontend (để config CORS)
FRONTEND_URL=http://localhost:5173
